{
  "name": "auto-math",
  "version": "0.2.3",
  "description": "Auto-expands LaTeX snippets. External rules with live reload, Custom Rules Editor, and default math pack.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
